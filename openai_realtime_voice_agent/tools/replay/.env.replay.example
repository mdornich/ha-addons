# Copy to .env.replay (gitignored) and edit. This file is loaded with
# `docker run --env-file`, so values are literal: no quotes, no shell expansion.
#
# OPENAI_API_KEY is deliberately a placeholder here and is OVERRIDDEN at run
# time by the real key from the environment (run_local.sh is invoked under
# 980labsOS scripts/with-8d-env.sh). Never paste a real key into this file.
OPENAI_API_KEY=PASTE_YOUR_OPENAI_KEY_HERE

# --- house tool: OFF ---------------------------------------------------------
# main.py only exposes the `house` tool when HA_DEVICE_ID *and* a token are set.
# Both blank => the tool is never registered, so no Home Assistant is touched
# and a house question degrades to the model answering without it.
HA_DEVICE_ID=
LONGLIVED_TOKEN=
ASSIST_PIPELINE_NAME=Trixie

# --- Dex tool: OFF -----------------------------------------------------------
DEX_ADAPTER_URL=
DEX_ADAPTER_TOKEN=

# --- model & voice -----------------------------------------------------------
OPENAI_MODEL=gpt-realtime-2
OPENAI_VOICE=marin
OPENAI_SPEED=1.0
MAX_OUTPUT_TOKENS=0
TRANSCRIPTION_MODEL=gpt-4o-transcribe
TRANSCRIPTION_LANGUAGE=en
INSTRUCTIONS=You are a terse test assistant. Answer in one short sentence. Speak only English.

# --- conversation ------------------------------------------------------------
# 0 = follow-up window disabled (turn-based). Set to e.g. 10 to exercise the
# follow-up path with tools/replay/replay_device.py --turn followup:...
FOLLOW_UP_LISTEN_SECONDS=0
FOLLOW_UP_MAX_TURNS=3
FOLLOW_UP_OPEN_DELAY_MS=700
WAKE_OPEN_DELAY_MS=700
VAD_EAGERNESS=low
PHASE_IDLE_DEBOUNCE_MS=1500

# --- web search --------------------------------------------------------------
# OFF for the harness: a live web search adds 10-20 s of unmeasured latency and
# extra spend. Turn it on only when that is what you are testing.
ENABLE_WEB_SEARCH=false
WEB_SEARCH_MODEL=gpt-5.5

# --- audio -------------------------------------------------------------------
PLAYBACK_PREBUFFER_MS=150
NOISE_REDUCTION=off
DEVICE_INPUT_SAMPLE_RATE=16000

# --- advanced ----------------------------------------------------------------
WEBSOCKET_PORT=8080
WEBSOCKET_HOST=0.0.0.0
SESSION_REUSE_TIMEOUT_SECONDS=300
MAX_CONTEXT_MESSAGES=12

# --- debug -------------------------------------------------------------------
ENABLE_RECORDING=false
DEBUG_RECORD_FOLLOWUP=false
